# Confluence Cloud credentials. Copy to .env and fill in; never commit .env.
# The CLI also accepts the ATLASSIAN_* aliases below.

# Base URL of your Confluence Cloud site, including /wiki.
CONFLUENCE_BASE_URL=https://your-site.atlassian.net/wiki

# Atlassian account email used to create the API token.
CONFLUENCE_EMAIL=you@company.com

# API token from https://id.atlassian.com/manage-profile/security/api-tokens
# Leave empty here and paste only into your local .env, never into chat or git.
CONFLUENCE_API_TOKEN=

# Optional aliases, useful when the same environment is shared with Jira tooling.
# ATLASSIAN_BASE_URL=https://your-site.atlassian.net/wiki
# ATLASSIAN_EMAIL=you@company.com
# ATLASSIAN_API_TOKEN=
